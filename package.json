{
  "name": "dsh-siri-bridge",
  "version": "0.4.1",
  "description": "Siri 语音桥插件：把 iPhone 快捷指令 / Siri 接进 DSH。说一句话进来，取回回复。带设置页：开关、选会话（可自己起名）、自动查找地址、局域网/Tailscale 走线、端口、日志。",
  "license": "MIT",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "siri",
    "shortcuts",
    "voice",
    "ios"
  ],
  "engines": {
    "node": ">=20"
  }
}
